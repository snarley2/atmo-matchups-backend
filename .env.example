# Shared Google Sheets configuration
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=google-service-account.json

# Main ATMO web backend
CLIENT_ORIGIN=http://localhost:5173
API_PORT=3001
ADMIN_LOGIN_PASSWORD=
ADMIN_SESSION_SECRET=
API_SECRET_KEY=

# Automation worker
DAILY_RUN_CRON=30 23 * * *
DAILY_RUN_TIMEZONE=America/New_York
WORKMYT_FIELD_DAY_URL=https://workmyt.com/fieldday
WORKMYT_EMAIL=
WORKMYT_PASSWORD=
WORKMYT_CAMPAIGN=MADHAV MEHTA
PERFORMANCE_LOOKBACK_DAYS=21

# Local working scraper defaults can still use installed Chrome/profile.
# On Render, these will later be replaced by Browserless connection settings.
CHROME_PATH=
CHROME_USER_DATA_DIR=
